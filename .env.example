# Copie para .env. Só o servidor de desenvolvimento (npm run dev / preview) lê estes valores;
# eles não vão para o código do navegador. Em produção, quem encaminha /api é o proxy reverso.

# Endereço da API (manhaw-translate: npm run api). Use a mesma porta do PORT do .env do backend.
API_PROXY=http://127.0.0.1:3000

# Porta da interface. Padrão: 5173
PORT=5173
